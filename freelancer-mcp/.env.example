# Token OAuth personal de tu cuenta de Freelancer.com.
# Se genera en https://accounts.freelancer.com/settings/develop (sección API / OAuth).
# Es el MISMO token que usa el radar (FREELANCER_OAUTH_TOKEN). NO se commitea.
FREELANCER_OAUTH_TOKEN=

# Tope diario de bids que el MCP postula por sesión (anti-patrón de bot).
# Por encima de esto, place_bid se niega y hay que hacerlo a mano. Default: 8.
FREELANCER_DAILY_BID_CAP=8

# Base de la API. Cambiá a https://www.freelancer.in si operás en ese dominio.
# Default: https://www.freelancer.com
FREELANCER_API_URL=https://www.freelancer.com
