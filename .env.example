# ─── Lead Detector · variables de entorno ───────────────────────────────────
# Copiá este archivo a .env.local y completá con valores reales.
# Las REQUERIDAS deben estar todas; sin ellas la app no arranca.
# Las OPCIONALES pueden faltar: si faltan, esa fuente queda inerte.

# ─── Supabase ────────────────────────────────────────────────────────────────
# REQUERIDAS. URL y anon key son públicas (se inyectan en el browser).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Service role key: bypassa RLS. Mantener en secreto, sólo en el servidor.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ─── Claude API ──────────────────────────────────────────────────────────────
# REQUERIDA. Filtra los posts con IA.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Evolution API (WhatsApp) ────────────────────────────────────────────────
# REQUERIDAS. Los avisos salen por una instancia propia de Evolution API
# (la misma infraestructura de "senders" del proyecto agente-busca-clientes).
EVOLUTION_API_URL=https://tu-evolution-api.example.com
EVOLUTION_API_KEY=tu-evolution-api-key
# Nombre de la instancia/sender desde la que se envía; tiene que estar conectada.
EVOLUTION_INSTANCE=wa-nombre-de-tu-sender
# Teléfono del dueño en formato E.164 (recibe los avisos de leads).
OWNER_WHATSAPP=+5491112345678

# ─── Seguridad ───────────────────────────────────────────────────────────────
# REQUERIDAS. Strings aleatorios largos (mín. 16 caracteres).
# Generar con: openssl rand -hex 32
CRON_SECRET=reemplazar-por-string-aleatorio-largo
AUTH_SECRET=reemplazar-por-string-aleatorio-largo
# Contraseña para entrar al dashboard.
DASHBOARD_PASSWORD=tu-password-de-dashboard

# ─── Fuentes / app ───────────────────────────────────────────────────────────
# REQUERIDA. User agent que Reddit exige en cada request.
REDDIT_USER_AGENT=lead-detector/1.0 (by /u/tu-usuario)
# REQUERIDA. URL base del deploy. En local: http://localhost:3000
# En Vercel se deriva automáticamente de VERCEL_URL si esta queda vacía.
APP_URL=http://localhost:3000

# ─── Opcionales ──────────────────────────────────────────────────────────────
# Credenciales de fuentes que requieren setup. Si faltan, esa fuente queda
# inerte, pero la app arranca igual.

# API de Freelancer.com
FREELANCER_OAUTH_TOKEN=
# API de Discord
DISCORD_BOT_TOKEN=
# Cliente de Telegram
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
# Servicio de scraping para Workana (paso 34, opcional)
SCRAPER_API_KEY=

# ─── Autopilot (v2) — canales de conversación ────────────────────────────────
# OPCIONALES. La app arranca sin ellas; cada canal no configurado queda inerte.

# Protege los webhooks entrantes de /api/inbound/* con timing-safe comparison.
# Mínimo 16 caracteres. Generar con: openssl rand -hex 32
# Sin esto, el outreach automático no puede recibir mensajes entrantes.
WEBHOOK_SECRET=

# URL pública del worker de Telegram desplegado en Railway.
# Se usa para que la app le ordene al worker que envíe un mensaje (POST /send).
TELEGRAM_WORKER_URL=

# Cuenta de Bluesky: handle o e-mail + app password (NO la contraseña real).
# Crear el app password en: https://bsky.app → Ajustes → App passwords
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Credenciales OAuth de una "script app" de Reddit (canal gated — autopilot off por defecto).
# Crear en: https://www.reddit.com/prefs/apps → "script"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
