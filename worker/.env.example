# ─── Telegram MTProto credentials ────────────────────────────────────────────
# Obtain from https://my.telegram.org → API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# String session generated by scripts/telegram-login.ts in the main app.
# Treat as a secret — gives full access to the Telegram account.
TELEGRAM_SESSION=1BVtsOKABu...

# ─── Main app connection ──────────────────────────────────────────────────────
# Public URL of the Vercel deployment (no trailing slash).
APP_URL=https://your-app.vercel.app

# Shared secret between this worker and the main app. Must be identical in both.
# Use a long random string: openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ─── Server ───────────────────────────────────────────────────────────────────
# Port the HTTP server listens on. Railway sets this automatically.
PORT=8080
